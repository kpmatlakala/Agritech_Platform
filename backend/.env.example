# Database (Aiven PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
# Optional SSL controls
# Set to true to force SSL even without sslmode in DATABASE_URL
PG_SSL=true
# In development with self-signed cert chains, set to false
PG_SSL_REJECT_UNAUTHORIZED=false

# Africa's Talking (USSD/SMS)
AFRICA_TALKING_API_KEY=your_api_key
AFRICA_TALKING_USERNAME=your_username

# JWT
JWT_SECRET=your_secret_key

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173